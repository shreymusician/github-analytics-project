# Copy to .env and fill in. Never commit .env.
# These are only the developer defaults; the product will take keys from each user (BYOK).
GITHUB_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=

# Optional: override default models (free-tier model names change often)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
